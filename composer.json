{
    "name": "armp/error-tracker",
    "description": "Laravel SDK that ships exceptions to a self-hosted error-tracking dashboard.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "errors", "exceptions", "monitoring", "observability"],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Armp\\ErrorTracker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Armp\\ErrorTracker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Armp\\ErrorTracker\\ErrorTrackerServiceProvider"
            ],
            "aliases": {
                "ErrorTracker": "Armp\\ErrorTracker\\Facades\\ErrorTracker"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
